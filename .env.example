# Copier en .env.local pour tester en local (npm run dev)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIza...
# Numéro du projet Google Cloud (nécessaire au Google Picker)
VITE_GOOGLE_APP_ID=123456789012
# Adresse du Worker Cloudflare (recettes de sites, YouTube, Edamam) — voir worker/README.md. Facultatif : réglable aussi dans l'app.
VITE_WORKER_URL=https://inmyfridge.xxxx.workers.dev
